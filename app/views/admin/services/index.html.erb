<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Services</h1>
    <%= link_to "New Service", new_admin_service_path, class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  </div>

  <table class="min-w-full bg-white border border-gray-200">
    <thead>
      <tr class="bg-gray-100 text-left border-b">
        <th class="py-2 px-4">Name</th>
        <th class="py-2 px-4">Duration</th>
        <th class="py-2 px-4">Price</th>
        <th class="py-2 px-4">Status</th>
        <th class="py-2 px-4">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @services.any? %>
        <% @services.each do |service| %>
          <tr id="<%= dom_id(service) %>" class="border-b">
            <td class="py-2 px-4"><%= service.name %></td>
            <td class="py-2 px-4"><%= service.duration_minutes %> mins</td>
            <td class="py-2 px-4"><%= service.display_price %></td>
            <td class="py-2 px-4">
              <% if service.active? %>
                <span class="text-green-700 font-semibold">Active</span>
              <% else %>
                <span class="text-gray-500 font-semibold">Inactive</span>
              <% end %>
            </td>
            <td class="py-2 px-4">
              <%= link_to "Edit", edit_admin_service_path(service), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="py-4 px-4 text-center text-gray-500">No services found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="mt-6">
    <%= link_to "Back to Admin Area", admin_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>
